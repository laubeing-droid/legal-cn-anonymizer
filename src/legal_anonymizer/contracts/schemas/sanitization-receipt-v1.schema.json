{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/sanitization-receipt-v1.schema.json",
  "title": "sanitization-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "profile_id",
    "provider_id",
    "provider_build_digest",
    "created_at",
    "status",
    "sanitized_bundle_hash",
    "artifact_hashes",
    "mapping_commitment",
    "source_set_commitment",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_build_digest": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "enum": [
        "AUTO_READY",
        "REVIEW_REQUIRED",
        "READY_BY_HUMAN",
        "CLOSED_BLOCK",
        "ENGINE_ERROR"
      ]
    },
    "sanitized_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "mapping_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_set_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invariants": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "review": {
      "title": "human-review-receipt-v1",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "matter_id",
        "report_hash",
        "sanitized_bundle_hash",
        "reviewer_subject",
        "reviewer_role",
        "decisions_hash",
        "issued_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "matter_id": {
          "type": "string"
        },
        "report_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sanitized_bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reviewer_subject": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "decisions_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "single_use": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "signature"
          ],
          "properties": {
            "algorithm": {
              "const": "Ed25519"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]+=*$"
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+=*$"
        }
      }
    }
  },
  "description": "Signed public receipt. Raw values, paths and the mapping are forbidden."
}
