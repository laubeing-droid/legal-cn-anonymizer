{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/project-manifest-v1.schema.json",
  "title": "project-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "profile_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^doc-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "AUTO_READY",
        "REVIEW_REQUIRED",
        "READY_BY_HUMAN",
        "CLOSED_BLOCK",
        "ENGINE_ERROR"
      ]
    }
  },
  "description": "Public project manifest. Raw file names are forbidden here."
}
