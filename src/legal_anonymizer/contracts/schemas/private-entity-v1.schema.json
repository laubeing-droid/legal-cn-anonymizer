{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/private-entity-v1.schema.json",
  "title": "private-entity-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "canonical_surface",
    "display_alias"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ent:[a-z-]+:[0-9]{4,}$"
    },
    "entity_type": {
      "enum": [
        "PERSON",
        "LEGAL_PERSON",
        "UNINCORPORATED_ORG",
        "PUBLIC_AUTHORITY",
        "COURT",
        "LAW_FIRM",
        "PROJECT_DEPARTMENT",
        "PROJECT",
        "LOCATION",
        "ACCOUNT",
        "DOCUMENT",
        "OTHER_PROTECTED"
      ]
    },
    "canonical_surface": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_alias": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transform": {
      "enum": [
        "KEEP",
        "PSEUDONYMIZE",
        "MASK_KEEP_LAST_4",
        "MASK_KEEP_FIRST_1",
        "GENERALIZE_YEAR",
        "GENERALIZE_ADMIN_DIVISION",
        "PHYSICAL_REDACT",
        "DROP_WITH_RECEIPT",
        "REVIEW"
      ]
    },
    "matter_secret_hmac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "description": "PRIVATE schema."
}
