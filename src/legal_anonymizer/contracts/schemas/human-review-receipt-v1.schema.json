{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/human-review-receipt-v1.schema.json",
  "title": "human-review-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "report_hash",
    "sanitized_bundle_hash",
    "reviewer_subject",
    "reviewer_role",
    "decisions_hash",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sanitized_bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer_subject": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "decisions_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "single_use": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+=*$"
        }
      }
    }
  }
}
