{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/portable-project-v1.schema.json",
  "title": "portable-project-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "kdf",
    "kdf_params",
    "cipher",
    "salt_b64",
    "nonce_b64",
    "ciphertext_b64",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string"
    },
    "kdf": {
      "const": "scrypt"
    },
    "kdf_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "r",
        "p"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 16384
        },
        "r": {
          "type": "integer",
          "minimum": 8
        },
        "p": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cipher": {
      "const": "aes-256-gcm"
    },
    "salt_b64": {
      "type": "string"
    },
    "nonce_b64": {
      "type": "string"
    },
    "ciphertext_b64": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
