{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/jc-privacy-facts-v1.schema.json",
  "title": "jc-privacy-facts-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "created_at",
    "facts",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "integer",
          "string"
        ]
      }
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+=*$"
        }
      }
    }
  },
  "description": "Closed-field privacy facts for juris-calculus consumption."
}
