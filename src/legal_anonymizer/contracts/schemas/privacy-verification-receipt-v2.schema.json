{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/privacy-verification-receipt-v2.schema.json",
  "title": "privacy-verification-receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "created_at",
    "gate_results",
    "verifier_build_digest",
    "detector_stack",
    "verifier_stack",
    "coverage",
    "residual_counts",
    "invariant_results"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "matter_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy",
        "completeness",
        "utility",
        "physical_redaction"
      ],
      "properties": {
        "privacy": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED",
            "REVIEW_REQUIRED"
          ]
        },
        "completeness": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ]
        },
        "utility": {
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW_REQUIRED",
            "NOT_EVALUATED"
          ]
        },
        "physical_redaction": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "verifier_build_digest": {
      "type": "string"
    },
    "detector_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mechanism",
          "modelId",
          "modelVersion"
        ],
        "properties": {
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verifier_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mechanism",
          "modelId",
          "modelVersion"
        ],
        "properties": {
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "reasons"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "residual_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "includes 'ner_residual': heterogeneous-verifier hits on final delivered content the production stack missed"
    },
    "invariant_results": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+=*$"
        }
      }
    }
  },
  "description": "Heterogeneous independent verification receipt (plan-v4.2 card 05-2)."
}
