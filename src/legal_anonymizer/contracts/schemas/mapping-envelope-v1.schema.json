{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-cn-anonymizer.local/schemas/mapping-envelope-v1.schema.json",
  "title": "mapping-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matter_id",
    "encryption",
    "entry_count",
    "mapping_commitment",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "matter_id": {
      "type": "string"
    },
    "encryption": {
      "enum": [
        "dpapi-current-user",
        "aes-256-gcm-scrypt"
      ]
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "mapping_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "description": "Public envelope of the private mapping; no mapping content."
}
